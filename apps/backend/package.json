{
  "name": "@hr-platform/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/server.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/lib/role-guard.test.ts src/modules/auth/services/password-reset-requester.test.ts src/modules/auth/services/password-reset-email.test.ts src/modules/auth/controllers/password-recovery.controller.test.ts src/modules/auth/middleware/password-recovery-error-handler.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:ensure": "tsx scripts/ensure-database.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "npm run db:ensure && npm run db:migrate",
    "seed:auth": "tsx scripts/seed-auth.ts",
    "seed:employees": "tsx scripts/seed-employees.ts",
    "verify:demo": "tsx scripts/verify-demo-seed.ts"
  },
  "dependencies": {
    "@hr-platform/shared": "*",
    "better-auth": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "nodemailer": "^10.1.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
